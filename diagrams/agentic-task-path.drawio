        <mxCell id="b_reject" value="Notify owner of rejection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;fontColor=#000000;fontSize=13;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry x="900" y="390" width="200" height="60" as="geometry" />
