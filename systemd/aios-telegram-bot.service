# Telegram transport unit. It receives Telegram updates, verifies the owner, and
# enqueues coding tasks into the durable queue. Only the Telegram bot token (from
# the secret manager via this service's machine-account token); NO Claude/GitHub/
# integration secrets.
[Unit]
Description=AI OS - Telegram Bot (transport)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aios-bot
WorkingDirectory=${AIOS_HOME}/apps/app
ExecStart=${AIOS_HOME}/apps/app/.venv/bin/python -m bot.telegram_bot
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
# Put ~/.local/bin on PATH so the secret-manager CLI resolves, for CONSISTENCY with the
# other secret-backed units. No extra blast radius: this service's machine account is scoped
# to only TELEGRAM_BOT_TOKEN, and its token also resolves directly from the env source first —
# so this only makes loader behavior consistent.
Environment=PATH=${AIOS_HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin
# Share ONE queue DB with the integrations-worker. AIOS_DATA_DB pins the file;
# AIOS_DATA_DB_GROUP makes connect() use group-rw perms so the (different-user) worker can
# read/write the same file. If the group does not exist yet, connect() safely falls back to
# single-user 0700/0600 — so this line is harmless before the group is provisioned.
Environment=AIOS_DATA_DB=${AIOS_HOME}/.ai-os/data/aios.sqlite3
Environment=AIOS_DATA_DB_GROUP=aios-queue
# Share ONE task-queue DB with the coding worker (same idea as AIOS_DATA_DB above, but for the
# task/approval/reply queue). Without these the transport and worker compute DIFFERENT paths via
# Path.home() and never see each other's rows; the group makes the cross-user share work.
Environment=AIOS_TASK_QUEUE_DB=${AIOS_HOME}/.ai-os/queue/tasks.sqlite3
Environment=AIOS_TASK_QUEUE_GROUP=aios-queue
# Activate the fail-closed per-service secret allow-list (a no-op unless AIOS_SERVICE_NAME is set).
# This transport may then resolve ONLY TELEGRAM_BOT_TOKEN (see config/secrets-map.yaml).
Environment=AIOS_SERVICE_NAME=telegram-bot
# Per-service env: AIOS_SECRETS_BACKEND + this service's machine-account token (scope
# telegram) + TELEGRAM_OWNER_ID (not a secret). Values are NOT in git. '-' = do not fail
# if the file is not present yet.
EnvironmentFile=-${AIOS_HOME}/.ai-os/env/telegram-bot.env
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
