# TARGET template. Note the two layers: bot.integrations_worker.run_loop(), called
# with no applier, is inert (it uses a stub). BUT the module's entry point main()
# — which THIS unit's ExecStart runs (python -m bot.integrations_worker) — wires in
# a LIVE Notion/Todoist applier that makes real network calls. So installing and
# starting this unit activates the real integrations; do it only after the machine
# account, secrets, and service-user boundary below are provisioned.
#
# Operator requirement — service-user boundary:
# The OS account the integrations-worker runs under MUST be distinct from the
# coding worker's account. This keeps the on-disk secret boundary (Notion API
# key, integration OAuth tokens) from being shared with the coding executor.
# Hence User=ai-os-integrations (a separate user from the coding worker). That
# account is created OUTSIDE this template (a provisioning step). If the account
# does not exist when the unit is installed, systemd refuses to start it — this
# is a hard precondition, not a silent fallback to the coding worker's account.
#
# Integrations: Notion / Todoist / model API / classifier backup.
# NOTE: in this build, write operations to Notion/Todoist execute directly once
# enqueued (no interactive preview step ships; a preview+confirm gate for
# outbound writes is a documented target - see docs/security/threat-model.md).
# No Claude Code credentials and no GitHub token.
#
# Code isolation: this worker runs its code AND its Python venv from a ROOT-OWNED tree
# (/opt/aios-integrations/app below) that the coding-worker user cannot write. So a compromised
# coding worker cannot swap the code or interpreter this keyed worker executes on its next
# restart (which would otherwise hand over the integration keys and the store key). The tree is
# provisioned OUTSIDE the coding worker's home by the deploy — a root-owned checkout (or rsync),
# refreshed only by a root-run update — so it is never writable by the coding worker.
# Token isolation additionally lives in the private EnvironmentFile (mode 0600 per service user).
[Unit]
Description=AI OS - Integrations Worker (Notion/Todoist reads and writes)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Distinct OS user from the coding worker. Hard precondition for the token
# boundary — secrets for integrations live in this user's private files, not
# shared with the coding executor.
User=ai-os-integrations
# Root-owned, coding-worker-unwritable code tree (see the isolation note above).
WorkingDirectory=/opt/aios-integrations/app
ExecStart=/opt/aios-integrations/app/.venv/bin/python -m bot.integrations_worker
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=HOME=${AIOS_INTEGRATIONS_HOME}
# Put ~/.local/bin on PATH so the secret-manager CLI resolves under systemd.
# AIOS_SECRETS_BACKEND=bitwarden REQUIRES this CLI to be resolvable; otherwise the
# integration secrets (Notion/Todoist/classifier) cannot be resolved.
Environment=PATH=${AIOS_INTEGRATIONS_HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin
# Share the transport's ONE queue DB. Different OS user -> pin the absolute path
# (AIOS_DATA_DB) and use group-rw perms (AIOS_DATA_DB_GROUP) so cross-user read/write works.
Environment=AIOS_DATA_DB=${AIOS_HOME}/.ai-os/data/aios.sqlite3
Environment=AIOS_DATA_DB_GROUP=aios-queue
Environment=AIOS_SECRETS_BACKEND=bitwarden
# Activate the fail-closed per-service secret allow-list (a no-op unless AIOS_SERVICE_NAME is set).
# This worker may then resolve ONLY its own allow-listed secrets (see config/secrets-map.yaml).
Environment=AIOS_SERVICE_NAME=integrations-worker
# Faster claim so a proxied Notion/Todoist op is picked up in ~0.25s (interactive latency).
Environment=AIOS_INTEGRATIONS_POLL_S=0.25
# The worker's own machine-account token (scope NOTION/TODOIST), private to THIS
# OS user (isolated from the coding executor). The operator places it at the path below,
# mode 0600 (NOT in git). '-' = do not fail if the file is not present yet.
EnvironmentFile=-${AIOS_INTEGRATIONS_HOME}/.ai-os/env/integrations-worker.env
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
