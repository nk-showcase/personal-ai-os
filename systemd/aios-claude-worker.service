# The claude-worker service: consumer of the durable task queue. The coding executor is
# Claude Code running on the server; its Claude login is a local-only file under ~/.claude
# (not from the secret manager, not from env). This service does NOT need the Telegram token.
# Pushes to a working branch run without confirmation; pushes to main and force-pushes require
# the operator's Allow/Deny via the per-tool approval gate (bot/claude_policy.approval_reason +
# make_gated_can_use_tool, enabled by default; see docs/security/approval-policy.md).
[Unit]
Description=AI OS - Claude Worker (coding executor)
After=network-online.target aios-telegram-bot.service
Wants=network-online.target

[Service]
Type=simple
User=ai-os
WorkingDirectory=${AIOS_HOME}/apps/app
ExecStart=${AIOS_HOME}/apps/app/.venv/bin/python -m bot.claude_worker
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=HOME=${AIOS_HOME}
# Put ~/.local/bin on PATH so secrets_loader finds `bws` (Bitwarden CLI) under systemd.
# systemd's default PATH excludes ~/.local/bin; without this, AIOS_SECRETS_BACKEND=bitwarden silently
# no-ops and this worker's secrets (ANTHROPIC_API_KEY, GITHUB_REPO_WRITE_TOKEN) would not resolve.
Environment=PATH=${AIOS_HOME}/.local/bin:/usr/local/bin:/usr/bin:/bin
# Share ONE queue DB with the transport. Without these, each service (running as a different OS
# user) computes a DIFFERENT queue path via Path.home(), so the bot would enqueue into one SQLite
# while the worker reads another. AIOS_TASK_QUEUE_DB pins the shared absolute path;
# AIOS_TASK_QUEUE_GROUP sets the group-rw perms so the two different-user services can share it.
Environment=AIOS_TASK_QUEUE_DB=${AIOS_HOME}/.ai-os/queue/tasks.sqlite3
Environment=AIOS_TASK_QUEUE_GROUP=aios-queue
# Activate the fail-closed per-service secret allow-list. Without AIOS_SERVICE_NAME the check in
# secrets_loader.get_secret is DISABLED (no-op); with it, this service can resolve ONLY its own
# allow-listed secrets (see config/secrets-map.yaml).
Environment=AIOS_SERVICE_NAME=claude-worker
# Per-service env: AIOS_SECRETS_BACKEND + the service's BWS_ACCESS_TOKEN (scope: claude-worker).
# Values are NOT in git. The leading '-' means: do not fail if the file does not exist yet.
EnvironmentFile=-${AIOS_HOME}/.ai-os/env/claude-worker.env
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
