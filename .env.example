# =============================================================================
# Example environment for the reference architecture.
# Copy to `.env` and fill in your own values. NEVER commit a real `.env`.
# No real secrets belong in this file - every value below is a placeholder.
# =============================================================================

# --- Secrets backend ---------------------------------------------------------
AIOS_SECRETS_BACKEND=env                 # secret source: "env" | "bitwarden" | "disk-cache"
AIOS_SECRETS_CACHE_DIR=./.secrets-cache  # dir for the disk-cache backend (0700, non-secret index only)
AIOS_SERVICE_NAME=telegram-bot           # least-privilege service identity (gates which secrets load)
BWS_ACCESS_TOKEN=                        # Bitwarden Secrets Manager token (only if backend=bitwarden)

# --- Core secrets (loaded via get_secret; keep OUT of shell history) ---------
TELEGRAM_BOT_TOKEN=000000000:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # Telegram bot API token
TELEGRAM_OWNER_ID=123456789              # numeric Telegram id of the single operator
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx                 # Claude API key (LLM ops)
CLAUDE_CODE_OAUTH_TOKEN=                 # Claude Code subscription OAuth token (coding worker)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx                          # GitHub read token
GITHUB_REPO_WRITE_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxx               # GitHub write token (coding worker push)
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxxxxx                     # Notion integration token (optional demo)
TODOIST_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx                           # Todoist API token (optional demo)

# --- Notion database ids (non-secret; empty = feature off) -------------------
NOTION_CLAUDE_CHATS_DB=<NOTION_DB_ID>    # Notion database id for chat history (optional)
NOTION_CLAUDE_MEMORY_PAGE=<NOTION_DB_ID> # Notion page/database id for memory (optional)
AIOS_RAW_NOTION_PERSIST=0                # explicit opt-in to persist raw free text to Notion (default off)
AIOS_DIALOGUE_PERSIST_MODE=structured_or_summary  # dialogue persistence mode

# --- At-rest encryption (age; public recipient is non-secret) ----------------
AIOS_CONTEXT_ENCRYPTION=0                # 1 = encrypt personal free-text at rest (schema 3). Production runs with 1; 0 here only so the demo starts without a key ceremony
AIOS_AGE_BIN=age                         # path to the `age` binary (falls back to PATH)
AIOS_CONTEXT_IDENTITY_FILE=${AIOS_HOME}/.ai-os/keys/context.identity  # 0600 worker-only age identity
AIOS_CONTEXT_KEK_FILE=${AIOS_HOME}/.ai-os/keys/context.kek            # 0600 wrapped key-encryption-key
AIOS_CONTEXT_ALLOW_TEST_KEK=0            # test-only: allow the sentinel KEK below (never in production)
AIOS_CONTEXT_TEST_KEK=                   # test-only sentinel KEK (leave empty in production)
# Recovery recipient (age PUBLIC key, non-secret). Needed so the master key is also sealed to your
# offline recovery key. Leave as the placeholder to seal to a single recipient (no offline recovery).
RECOVERY_RECIPIENT=age1PLACEHOLDER       # your offline recovery age public key (age-keygen -y ...)

# --- Store-op sealing (optional; seals queue store envelopes to the worker) --
AIOS_STORE_SEAL=0                        # 1 = age-seal store-op envelopes to the worker recipient
# Worker context PUBLIC recipient. Required when AIOS_STORE_SEAL=1; with the placeholder, sealing stays
# inert (fail-closed on the transport side) - set your real worker age public key to activate it.
STORE_SEAL_RECIPIENT=age1PLACEHOLDER     # worker context age public key (age-keygen -y ...)

# --- Router transport encryption (independent age recipient) -----------------
AIOS_UNIFIED_ROUTER=0                    # opt-in: single unified callback/message router
AIOS_ROUTER_ENCRYPT=0                    # opt-in: age-encrypt router envelopes to the worker
AIOS_ROUTER_IDENTITY_FILE=${AIOS_HOME}/.ai-os/keys/router.identity   # 0600 router worker age identity
AIOS_ROUTER_DISPATCH=0                   # opt-in: keyed-worker dispatch slice

# --- Storage / database paths ------------------------------------------------
AIOS_DATA_DB=${AIOS_HOME}/.ai-os/data.db          # main SQLite database path
AIOS_DATA_DB_GROUP=                               # optional unix group for the db file
AIOS_TASK_QUEUE_DB=${AIOS_HOME}/.ai-os/queue.db   # durable task-queue SQLite path
AIOS_TASK_QUEUE_GROUP=                            # optional unix group for the queue db
AIOS_PTB_STATE_DIR=${AIOS_HOME}/.ai-os/ptb-state  # python-telegram-bot persistence dir

# --- Timezone / clock (all configurable; no hard-coded local time) -----------
AIOS_TZ=UTC                              # primary timezone (IANA name, e.g. "UTC")
AIOS_SCHEDULE_TZ=UTC                     # timezone the scheduler interprets plan times in
AIOS_DISPLAY_TZ_OFFSET_H=0               # display offset in hours from UTC
AIOS_LOCAL_UTC_OFFSET_HOURS=0            # local offset in hours from UTC
AIOS_REMINDER_UTC_OFFSET_HOURS=0         # reminder offset in hours from UTC

# --- Worker / queue polling and leasing --------------------------------------
AIOS_WORKER_ID=worker-1                  # id of the coding worker instance
AIOS_WORKER_POLL_S=2                     # coding-worker queue poll interval (seconds)
AIOS_REPLY_POLL_S=2                      # reply-queue poll interval (seconds)
AIOS_SYNC_POLL_S=60                      # host-sync poll interval (seconds)
AIOS_SCHEDULE_TICK_S=30                  # scheduler tick interval (seconds)
AIOS_APPROVAL_TIMEOUT=300                # Allow/Deny approval wait timeout (seconds)
AIOS_AUTO_RESTART_POLL_S=5               # auto-restart supervisor poll interval (seconds)
AIOS_INTEGRATIONS_WORKER_ID=integrations-1  # id of the integrations worker instance
AIOS_INTEGRATIONS_POLL_S=2               # integrations-worker poll interval (seconds)
AIOS_INTEGRATIONS_SWEEP_S=60             # integrations lease-sweep interval (seconds)
AIOS_INTEGRATIONS_LEASE_S=120            # integrations job lease duration (seconds)
AIOS_INTEGRATIONS_MAX_ATTEMPTS=5         # integrations job max retry attempts
AIOS_INTEGRATIONS_BACKOFF_BASE_S=2       # integrations retry backoff base (seconds)
AIOS_INTEGRATIONS_BACKOFF_MAX_S=300      # integrations retry backoff ceiling (seconds)
AIOS_INTEGRATION_ACCOUNT=default         # logical integration account label

# --- Privilege drop (container / process hardening) --------------------------
AIOS_CONTAINER_DROP_PRIV=0               # 1 = drop privileges to the container user on start
AIOS_CONTAINER_USER=appuser              # unix user to drop to
AIOS_CONTAINER_HOME=${AIOS_HOME}         # home dir after privilege drop

# --- Claude coding worker (approval gate + permission mode + git identity) ---
AIOS_TOOL_APPROVALS=1                    # per-tool Allow/Deny gate for dangerous actions; ON by default (fail-closed, 5-min timeout = deny). 0 = kill-switch: no per-tool prompts (bypassPermissions)
AIOS_CLAUDE_PERMISSION_MODE=             # normally leave EMPTY — the mode is derived from the gate (on -> 'default', off -> 'bypassPermissions'). An explicit value always wins; explicit bypassPermissions also disables the gate
AIOS_REPO_DIR=${AIOS_HOME}/repo          # repository the coding worker operates on
AIOS_GIT_BIN=git                         # path to the git binary
AIOS_GIT_BOT_NAME=aios-bot               # git author name for automated commits
AIOS_GIT_BOT_EMAIL=bot@example.com       # git author email for automated commits
AIOS_PUSH_ORG=<YOUR_ORG>                 # GitHub org/owner to push automated commits to

# --- /bridge coding agent (project routing, model, effort) -------------------
BRIDGE_PROJECTS=projectA,projectB        # comma-separated project aliases the bridge accepts
BRIDGE_WORK_DIR=${AIOS_HOME}/bridge      # working dir for the bridge agent
BRIDGE_SKILLS_DIR=${AIOS_HOME}/.claude/skills  # skills dir the bridge agent reads
BRIDGE_RECENT_SESSIONS_FILE=${AIOS_HOME}/.ai-os/bridge-recent.json  # recent-sessions pointer file
BRIDGE_MODEL=claude-sonnet-4            # model id for the bridge agent
BRIDGE_MAX_TURNS=20                      # max agent turns per bridge task
BRIDGE_THINKING=0                        # 1 = enable extended thinking
BRIDGE_EFFORT=medium                     # effort level: low | medium | high
BRIDGE_GIT_NAME=aios-bridge              # git author name for bridge commits
BRIDGE_GIT_EMAIL=bridge@example.com      # git author email for bridge commits
AIOS_DESIGN_TRIGGERS=                    # optional comma-separated trigger words (leave empty)

# --- Backups -----------------------------------------------------------------
AIOS_BACKUP_DIR=${AIOS_HOME}/.ai-os/backups        # backup output directory
AIOS_BACKUP_AGE_RECIPIENT=age1PLACEHOLDER0000000000000000000000000000000000000000000000000  # age public recipient for backups (non-secret)
